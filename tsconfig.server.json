{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "dist/server",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "server/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "src",
    "api",
    "dist"
  ]
}
